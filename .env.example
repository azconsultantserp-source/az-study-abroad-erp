# ── PostgreSQL (self-hosted on the same Hostinger VPS via Docker) ───────
# Postgres is NOT exposed to the internet — only the app container can reach it.
POSTGRES_USER="azc"
POSTGRES_PASSWORD="change-me-strong-password-here"
POSTGRES_DB="az_erp"

# Must use the Docker service hostname "postgres" (not localhost or the public IP).
DATABASE_URL="postgresql://azc:change-me-strong-password-here@postgres:5432/az_erp?schema=public&connection_limit=10&pool_timeout=20"

# Tip: run `bash deploy/setup-env.sh` on the VPS to auto-generate strong passwords.

# ── Auth (Auth.js v5) ───────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# Your public HTTPS domain.
AUTH_URL="https://erp.azconsultants.com"
NEXTAUTH_URL="https://erp.azconsultants.com"
AUTH_TRUST_HOST="true"

# ── App ─────────────────────────────────────────────────────────────────
NODE_ENV="production"
UPLOAD_DIR="/app/uploads"

# ── Document storage ────────────────────────────────────────────────────
# local = disk under UPLOAD_DIR (default on your PC)
# r2    = Cloudflare R2 private bucket (recommended on Hostinger)
STORAGE_BACKEND="local"

# Required only when STORAGE_BACKEND=r2 (create in Cloudflare → R2 → API Tokens):
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET="az-erp-documents"
# Optional override (defaults to https://<ACCOUNT_ID>.r2.cloudflarestorage.com):
# R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"

# Optional: limit CPUs during build on a low-memory VPS.
# NEXT_BUILD_CPUS="1"
